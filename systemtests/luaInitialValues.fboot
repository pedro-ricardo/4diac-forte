LuaInitialValues;<Request ID="2" Action="CREATE"><FBType Name="luatest::InitialValues">-- Checks the initial values of its input and its STRUCT internal variable, V keeps its initial value&#10;local DI_A = 33554432&#10;local DO_OK = 67108864&#10;local IN_S = 268435456&#10;&#10;return {&#10;  ECC = function(fb, id)&#10;    if id == 0 then&#10;      local s = fb[IN_S]&#10;      fb[DO_OK] = fb[DI_A] == 5 and s.ENABLED and s.VALUE == 2.5 and s.INNER.ID == 7 and s.INNER.LABEL == &quot;in&quot; and&#10;        s.SAMPLES[0] == 1 and s.SAMPLES[3] == 4 and s.ITEMS[1].ID == 8 and s.ITEMS[2].LABEL == &quot;b&quot;&#10;      fb(0)&#10;    end&#10;  end,&#10;  interfaceSpec = {&#10;    numEIs = 1, EINames = {&quot;REQ&quot;}, EIWith = {0, 65535}, EIWithIndexes = {0},&#10;    numEOs = 1, EONames = {&quot;CNF&quot;}, EOWith = {0, 1, 65535}, EOWithIndexes = {0},&#10;    numDIs = 1, DINames = {&quot;A&quot;}, DIDataTypeNames = {&quot;INT&quot;}, DIInitialValues = {&quot;5&quot;},&#10;    numDOs = 2, DONames = {&quot;OK&quot;, &quot;V&quot;}, DODataTypeNames = {&quot;BOOL&quot;, &quot;LREAL&quot;}, DOInitialValues = {&quot;&quot;, &quot;1.25&quot;},&#10;    numAdapters = 0, adapterInstanceDefinition = {}&#10;  },&#10;  internalVarsInformation = {&#10;    numIntVars = 1, intVarsNames = {&quot;S&quot;}, intVarsDataTypeNames = {&quot;luatest::LuaTestStruct&quot;},&#10;    intVarsInitialValues = {&#10;      &quot;(ENABLED:=TRUE,VALUE:=2.5,INNER:=(ID:=7,LABEL:=&apos;in&apos;),SAMPLES:=[1,2,3,4],&quot; ..&#10;      &quot;ITEMS:=[(ID:=8,LABEL:=&apos;a&apos;),(ID:=9,LABEL:=&apos;b&apos;)])&quot;&#10;    }&#10;  }&#10;}&#10;</FBType></Request>
