LuaCompositeInOut;<Request ID="2" Action="CREATE"><FBType Name="luatest::CIOAdd">-- REQ adds STEP to the in-out variable V and copies the result to OUT&#10;local DI_STEP = 33554432&#10;local DO_OUT = 67108864&#10;local DIO_V = 100663296&#10;&#10;return {&#10;  ECC = function(fb, id)&#10;    if id == 0 then&#10;      fb[DIO_V] = fb[DIO_V] + fb[DI_STEP]&#10;      fb[DO_OUT] = fb[DIO_V]&#10;      fb(0)&#10;    end&#10;  end,&#10;  interfaceSpec = {&#10;    numEIs = 1, EINames = {&quot;REQ&quot;}, EIWith = {0, 1, 65535}, EIWithIndexes = {0},&#10;    numEOs = 1, EONames = {&quot;CNF&quot;}, EOWith = {0, 1, 65535}, EOWithIndexes = {0},&#10;    numDIs = 1, DINames = {&quot;STEP&quot;}, DIDataTypeNames = {&quot;INT&quot;},&#10;    numDOs = 1, DONames = {&quot;OUT&quot;}, DODataTypeNames = {&quot;INT&quot;},&#10;    numDIOs = 1, DIONames = {&quot;V&quot;}, DIODataTypeNames = {&quot;INT&quot;}, DIOInitialValues = {&quot;10&quot;},&#10;    numAdapters = 0, adapterInstanceDefinition = {}&#10;  }&#10;}&#10;</FBType></Request>
LuaCompositeInOut;<Request ID="3" Action="CREATE"><FBType Name="luatest::CIOWrap">-- the in-out variable V is passed to the in-out variable of the internal ADD&#10;return {&#10;  interfaceSpec = {&#10;    numEIs = 1, EINames = {&quot;REQ&quot;}, EIWith = {0, 1, 65535}, EIWithIndexes = {0},&#10;    numEOs = 1, EONames = {&quot;CNF&quot;}, EOWith = {0, 1, 65535}, EOWithIndexes = {0},&#10;    numDIs = 1, DINames = {&quot;STEP&quot;}, DIDataTypeNames = {&quot;INT&quot;},&#10;    numDOs = 1, DONames = {&quot;OUT&quot;}, DODataTypeNames = {&quot;INT&quot;},&#10;    numDIOs = 1, DIONames = {&quot;V&quot;}, DIODataTypeNames = {&quot;INT&quot;}, DIOInitialValues = {&quot;100&quot;},&#10;    numAdapters = 0, adapterInstanceDefinition = {}&#10;  },&#10;  fbnSpec = {&#10;    internalFBs = {{fbNameID = &quot;ADD&quot;, fbTypeID = &quot;luatest::CIOAdd&quot;}}, parameters = {},&#10;    eventConnections = {&#10;      {srcID = &quot;REQ&quot;, srcFBNum = -1, dstID = &quot;REQ&quot;, dstFBNum = 0},&#10;      {srcID = &quot;CNF&quot;, srcFBNum = 0, dstID = &quot;CNF&quot;, dstFBNum = -1}&#10;    },&#10;    dataConnections = {&#10;      {srcID = &quot;STEP&quot;, srcFBNum = -1, dstID = &quot;STEP&quot;, dstFBNum = 0},&#10;      {srcID = &quot;V&quot;, srcFBNum = -1, dstID = &quot;V&quot;, dstFBNum = 0},&#10;      {srcID = &quot;OUT&quot;, srcFBNum = 0, dstID = &quot;OUT&quot;, dstFBNum = -1}&#10;    },&#10;    adapterConnections = {},&#10;    numFBs = 1, numECons = 2, numDCons = 3, numAdpCons = 0, numParams = 0&#10;  }&#10;}&#10;</FBType></Request>
