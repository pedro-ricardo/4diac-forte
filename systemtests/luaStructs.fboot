;<Request ID="1" Action="CREATE"><FB Name="LuaStructs" Type="iec61499::system::EMB_RES" /></Request>
LuaStructs;<Request ID="2" Action="CREATE"><FBType Name="luatest::StructCopy">local DI_IN = 33554432&#10;local DO_OUT = 67108864&#10;&#10;-- REQ doubles VALUE, increments INNER.ID, sums SAMPLES[0..2] into SAMPLES[3] and marks ITEMS[2].LABEL&#10;local function executeEvent(fb, id)&#10;  if id == 0 then&#10;    local v = fb[DI_IN]&#10;    v.VALUE = v.VALUE * 2&#10;    v.INNER.ID = v.INNER.ID + 1&#10;    v.SAMPLES[3] = v.SAMPLES[0] + v.SAMPLES[1] + v.SAMPLES[2]&#10;    v.ITEMS[2].LABEL = v.ITEMS[1].LABEL .. &quot;!&quot;&#10;    fb[DO_OUT] = v&#10;    fb(0)&#10;  end&#10;end&#10;&#10;local interfaceSpec = {&#10;  numEIs = 1, EINames = {&quot;REQ&quot;}, EIWith = {0, 65535}, EIWithIndexes = {0},&#10;  numEOs = 1, EONames = {&quot;CNF&quot;}, EOWith = {0, 65535}, EOWithIndexes = {0},&#10;  numDIs = 1, DINames = {&quot;IN&quot;}, DIDataTypeNames = {&quot;luatest::LuaTestStruct&quot;},&#10;  numDOs = 1, DONames = {&quot;OUT&quot;}, DODataTypeNames = {&quot;luatest::LuaTestStruct&quot;},&#10;  numAdapters = 0, adapterInstanceDefinition = {}&#10;}&#10;&#10;return {ECC = executeEvent, interfaceSpec = interfaceSpec}&#10;</FBType></Request>
LuaStructs;<Request ID="3" Action="CREATE"><FBType Name="luatest::StructCheck">local DI_IN = 33554432&#10;local DO_OK = 67108864&#10;&#10;local function executeEvent(fb, id)&#10;  if id == 0 then&#10;    local v = fb[DI_IN]&#10;    fb[DO_OK] = v.ENABLED == true and v.VALUE == 3.0 and v.INNER.ID == 8 and v.INNER.LABEL == &quot;in&quot;&#10;      and v.SAMPLES.lo == 0 and v.SAMPLES.up == 3&#10;      and v.SAMPLES[0] == 1 and v.SAMPLES[1] == 2 and v.SAMPLES[2] == 3 and v.SAMPLES[3] == 6&#10;      and v.ITEMS.lo == 1 and v.ITEMS.up == 2&#10;      and v.ITEMS[1].ID == 1 and v.ITEMS[1].LABEL == &quot;a&quot; and v.ITEMS[2].ID == 2 and v.ITEMS[2].LABEL == &quot;a!&quot;&#10;    fb(0)&#10;  end&#10;end&#10;&#10;local interfaceSpec = {&#10;  numEIs = 1, EINames = {&quot;REQ&quot;}, EIWith = {0, 65535}, EIWithIndexes = {0},&#10;  numEOs = 1, EONames = {&quot;CNF&quot;}, EOWith = {0, 65535}, EOWithIndexes = {0},&#10;  numDIs = 1, DINames = {&quot;IN&quot;}, DIDataTypeNames = {&quot;luatest::LuaTestStruct&quot;},&#10;  numDOs = 1, DONames = {&quot;OK&quot;}, DODataTypeNames = {&quot;BOOL&quot;},&#10;  numAdapters = 0, adapterInstanceDefinition = {}&#10;}&#10;&#10;return {ECC = executeEvent, interfaceSpec = interfaceSpec}&#10;</FBType></Request>
