;<Request ID="1" Action="CREATE"><FB Name="LuaTypes" Type="iec61499::system::EMB_RES" /></Request>
;<Request ID="2" Action="CREATE"><AdapterType Name="luatest::ACounter">local interfaceSpec = {&#10;  numEIs = 2,&#10;  EINames = {&quot;REQ&quot;, &quot;R&quot;},&#10;  EIWith = {0, 65535},&#10;  EIWithIndexes = {0, -1},&#10;  numEOs = 1,&#10;  EONames = {&quot;CNF&quot;},&#10;  EOWith = {0, 1, 65535},&#10;  EOWithIndexes = {0},&#10;  numDIs = 1,&#10;  DINames = {&quot;PV&quot;},&#10;  DIDataTypeNames = {&quot;UINT&quot;},&#10;  numDOs = 2,&#10;  DONames = {&quot;Q&quot;, &quot;CV&quot;},&#10;  DODataTypeNames = {&quot;BOOL&quot;, &quot;UINT&quot;}&#10;}&#10;&#10;return {interfaceSpec = interfaceSpec}&#10;</AdapterType></Request>
LuaTypes;<Request ID="3" Action="CREATE"><FBType Name="luatest::Counter">local STfunc = require &quot;STfunc&quot;&#10;&#10;local FB_STATE = 0&#10;local ECC_START = 0&#10;local ECC_INIT = 1&#10;local ECC_COUNT = 2&#10;local EI_INIT = 0&#10;local EI_REQ = 1&#10;local EO_INITO = 0&#10;local EO_CNF = 1&#10;local DI_PV = 33554432&#10;local DO_Q = 67108864&#10;local DO_CV = 67108865&#10;local IN_STEP = 268435456&#10;&#10;local function alg_initialize(fb)&#10;  local ENV = {}&#10;  ENV.fb_var_CV = 0&#10;  ENV.fb_var_STEP = 1&#10;  ENV.fb_var_Q = false&#10;  fb[IN_STEP] = ENV.fb_var_STEP&#10;  fb[DO_Q] = ENV.fb_var_Q&#10;  fb[DO_CV] = ENV.fb_var_CV&#10;end&#10;&#10;local function alg_count(fb)&#10;  local ENV = {}&#10;  ENV.fb_var_PV = fb[DI_PV]&#10;  ENV.fb_var_CV = fb[DO_CV]&#10;  ENV.fb_var_STEP = fb[IN_STEP]&#10;  ENV.fb_var_CV = STfunc.ADD(ENV.fb_var_CV, ENV.fb_var_STEP)&#10;  ENV.fb_var_Q = STfunc.GE(ENV.fb_var_CV, ENV.fb_var_PV)&#10;  fb[DO_Q] = ENV.fb_var_Q&#10;  fb[DO_CV] = ENV.fb_var_CV&#10;end&#10;&#10;local function enterECC_START(fb)&#10;  fb[FB_STATE] = ECC_START&#10;  return true&#10;end&#10;&#10;local function enterECC_INIT(fb)&#10;  fb[FB_STATE] = ECC_INIT&#10;  alg_initialize(fb)&#10;  fb(EO_INITO)&#10;  return true&#10;end&#10;&#10;local function enterECC_COUNT(fb)&#10;  fb[FB_STATE] = ECC_COUNT&#10;  alg_count(fb)&#10;  fb(EO_CNF)&#10;  return true&#10;end&#10;&#10;local function transition(fb, id)&#10;  local STATE = fb[FB_STATE]&#10;  local VAR_PV = fb[DI_PV]&#10;  local VAR_CV = fb[DO_CV]&#10;  if ECC_START == STATE then&#10;    if EI_INIT == id then return enterECC_INIT(fb)&#10;    elseif EI_REQ == id and (VAR_CV &lt; VAR_PV) then return enterECC_COUNT(fb)&#10;    else return false&#10;    end&#10;  elseif ECC_INIT == STATE or ECC_COUNT == STATE then&#10;    return enterECC_START(fb)&#10;  end&#10;  return false&#10;end&#10;&#10;local function executeEvent(fb, id)&#10;  local modified = transition(fb, id)&#10;  while modified do&#10;    modified = transition(fb, -1)&#10;  end&#10;end&#10;&#10;local interfaceSpec = {&#10;  numEIs = 2,&#10;  EINames = {&quot;INIT&quot;, &quot;REQ&quot;},&#10;  EIWith = {0, 65535, 0, 65535},&#10;  EIWithIndexes = {0, 2},&#10;  numEOs = 2,&#10;  EONames = {&quot;INITO&quot;, &quot;CNF&quot;},&#10;  EOWith = {1, 65535, 0, 1, 65535},&#10;  EOWithIndexes = {0, 2},&#10;  numDIs = 1,&#10;  DINames = {&quot;PV&quot;},&#10;  DIDataTypeNames = {&quot;UINT&quot;},&#10;  numDOs = 2,&#10;  DONames = {&quot;Q&quot;, &quot;CV&quot;},&#10;  DODataTypeNames = {&quot;BOOL&quot;, &quot;UINT&quot;},&#10;  numAdapters = 1,&#10;  adapterInstanceDefinition = {&#10;    {adapterNameID = &quot;NEXT&quot;, adapterTypeNameID = &quot;luatest::ACounter&quot;, isPlug = true}&#10;  }&#10;}&#10;&#10;local internalVarsInformation = {&#10;  numIntVars = 1,&#10;  intVarsNames = {&quot;STEP&quot;},&#10;  intVarsDataTypeNames = {&quot;UINT&quot;}&#10;}&#10;&#10;return {ECC = executeEvent, interfaceSpec = interfaceSpec, internalVarsInformation = internalVarsInformation}&#10;</FBType></Request>
